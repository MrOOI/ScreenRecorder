<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens: dark theme. Keys must match Light.xaml. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1B1B1E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#26262A" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#303036" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#3A3A41" />
    <SolidColorBrush x:Key="BorderBrush" Color="#37373E" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#5A5A63" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEDEF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0A8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#EC5D61" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#C4363B" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#3B2224" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#1F3326" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#7FD69B" />
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#3A1F21" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A8A" />
    <SolidColorBrush x:Key="FocusBrush" Color="#9E9EF0" />
    <SolidColorBrush x:Key="OverlayDimBrush" Color="#80000000" />
</ResourceDictionary>
