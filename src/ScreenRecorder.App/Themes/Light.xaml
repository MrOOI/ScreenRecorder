<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens: light theme. Keys must match Dark.xaml. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F7F8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EFEFF1" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E4E4E7" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DEDEE2" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#B9B9C0" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C1C1F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B6B73" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D93D42" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#C4363B" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#FCE8E9" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#E8F5EC" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E7B3C" />
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
    <SolidColorBrush x:Key="FocusBrush" Color="#5B5BD6" />
    <SolidColorBrush x:Key="OverlayDimBrush" Color="#80000000" />
</ResourceDictionary>
