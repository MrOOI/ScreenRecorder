<Window x:Class="ScreenRecorder.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScreenRecorder.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Screen Recorder"
        Icon="/Assets/app.ico"
        Width="440"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="20,18,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- What to record -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Source" VerticalAlignment="Center"
                   Style="{StaticResource CaptionText}" />
        <ComboBox Grid.Row="0" Grid.Column="1"
                  ItemsSource="{Binding Sources.Options}"
                  SelectedItem="{Binding Sources.Selected}"
                  DisplayMemberPath="Label"
                  IsEnabled="{Binding CanChangeOptions}"
                  AutomationProperties.Name="Recording source" />

        <!-- What to include -->
        <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" IsEnabled="{Binding CanChangeOptions}">
            <CheckBox Content="System audio" IsChecked="{Binding CaptureSystemAudio}" Margin="0,0,18,4" />
            <CheckBox Content="Microphone" IsChecked="{Binding CaptureMicrophone}" Margin="0,0,18,4" />
            <CheckBox Content="Cursor" IsChecked="{Binding ShowCursor}" Margin="0,0,0,4" />
        </WrapPanel>

        <!-- Record / stop, pause, timer -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ToggleRecordingCommand}"
                    AutomationProperties.Name="{Binding PrimaryActionText}">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource OnAccentBrush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Rectangle RadiusX="2" RadiusY="2" Fill="{DynamicResource OnAccentBrush}"
                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <TextBlock Text="{Binding PrimaryActionText}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SecondaryPillButton}"
                    Content="{Binding PauseResumeText}"
                    Command="{Binding PauseResumeCommand}"
                    Visibility="{Binding IsPauseVisible, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding ElapsedText}" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"
                           AutomationProperties.Name="Elapsed time" />
                <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right"
                           Style="{StaticResource CaptionText}" />
            </StackPanel>
        </Grid>

        <!-- Result / error notice -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="0,16,0,0" Padding="12,8,6,8" CornerRadius="8"
                DataContext="{Binding Banner}"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ErrorSubtleBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26"
                        FontSize="10" Content="&#xE711;" ToolTip="Dismiss"
                        AutomationProperties.Name="Dismiss" Command="{Binding DismissCommand}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,4,0"
                            Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Open" Height="26" Padding="10,0" Command="{Binding OpenFileCommand}" />
                    <Button Content="Show in folder" Height="26" Padding="10,0" Margin="6,0,0,0"
                            Command="{Binding RevealFileCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Where it goes -->
        <DockPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;"
                    ToolTip="Settings" AutomationProperties.Name="Settings"
                    Command="{Binding OpenSettingsCommand}" />
            <Button Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                    ToolTip="{Binding OutputFolder}" AutomationProperties.Name="Open recordings folder"
                    Command="{Binding OpenOutputFolderCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,1,6,0" />
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="Saves to" /> <Run Text="{Binding OutputFolderDisplay, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</Window>
