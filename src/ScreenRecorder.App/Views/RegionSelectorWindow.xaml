<Window x:Class="ScreenRecorder.App.Views.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScreenRecorder.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:RegionSelectorViewModel}"
        Title="Select region"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        FontFamily="Segoe UI"
        WindowStartupLocation="Manual">
    <Canvas x:Name="Surface" ClipToBounds="True">
        <!-- Dim everything except the selection (even-odd fill cuts the hole). -->
        <Path Fill="{DynamicResource OverlayDimBrush}" IsHitTestVisible="False">
            <Path.Data>
                <GeometryGroup FillRule="EvenOdd">
                    <RectangleGeometry Rect="{Binding Bounds}" />
                    <RectangleGeometry Rect="{Binding Selection}" />
                </GeometryGroup>
            </Path.Data>
        </Path>

        <Border Canvas.Left="{Binding Selection.X}" Canvas.Top="{Binding Selection.Y}"
                Width="{Binding Selection.Width}" Height="{Binding Selection.Height}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                IsHitTestVisible="False"
                Visibility="{Binding IsSelecting, Converter={StaticResource BoolToVisibility}}" />

        <Border Canvas.Left="{Binding Selection.X}" Canvas.Top="{Binding Selection.Bottom}"
                Margin="0,8,0,0" Padding="8,3" CornerRadius="6" Background="#E61B1B1E"
                IsHitTestVisible="False"
                Visibility="{Binding IsSelecting, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding SizeText}" Foreground="White" FontSize="12" />
        </Border>

        <Border x:Name="Hint" Padding="16,10" CornerRadius="10" Background="#E61B1B1E"
                IsHitTestVisible="False"
                Visibility="{Binding ShowHint, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Foreground="White" FontSize="14">
                <Run Text="Drag to select an area" FontWeight="SemiBold" />
                <Run Text="  ·  Esc to cancel" Foreground="#B3FFFFFF" />
            </TextBlock>
        </Border>
    </Canvas>
</Window>
