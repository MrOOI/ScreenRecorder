<Window x:Class="ScreenRecorder.App.Views.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScreenRecorder.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:WindowPickerViewModel}"
        Title="Choose a window"
        Icon="/Assets/app.ico"
        Width="440" Height="420"
        MinWidth="320" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="WindowList"
                 ItemsSource="{Binding Windows}"
                 SelectedItem="{Binding Selected}"
                 AutomationProperties.Name="Windows"
                 MouseDoubleClick="OnListDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ProcessName}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="No windows to record. Open an app and press Refresh."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Style="{StaticResource CaptionText}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <DockPanel Grid.Row="1" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Refresh" Command="{Binding RefreshCommand}" />
            <Button DockPanel.Dock="Right" Content="Cancel" Margin="8,0,0,0" IsCancel="True"
                    Command="{Binding CancelCommand}" />
            <Button DockPanel.Dock="Right" Content="Record this window" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Height="34" MinWidth="0" Tag="8" FontSize="13"
                    Command="{Binding ConfirmCommand}" />
        </DockPanel>
    </Grid>
</Window>
